# 이 파일을 복사해서 .env로 만들고 실제 값을 채우세요.
#   cp .env.example .env
# .env는 .gitignore에 의해 커밋되지 않습니다.

# ── Google Cloud 프로젝트 ──
GOOGLE_CLOUD_PROJECT=
VERTEX_LOCATION=asia-northeast3

# ── SOLAPI (문자 발송) ──
# https://console.solapi.com 에서 발급
SOLAPI_API_KEY=
SOLAPI_API_SECRET=
SOLAPI_FROM_NUMBER=

# ── 문자에 들어가는 서비스 링크 ──
SERVICE_URL=https://your-service-url.a.run.app

# ── 알림 저장소 (Firestore + KMS) ──
# PHONE_ID_PEPPER: 32자 이상 임의의 랜덤 문자열. 반드시 Secret Manager 등에서
#   따로 생성해서 넣을 것. 절대 이 값을 예시로 쓰거나 소스에 하드코딩하지 말 것.
PHONE_ID_PEPPER=
# KMS_KEY_NAME: 운영 환경에서는 이 값을 채워서 실제 KMS로 암호화한다.
#   projects/PROJECT_ID/locations/LOCATION/keyRings/RING/cryptoKeys/KEY
KMS_KEY_NAME=
# 로컬 개발에서 KMS_KEY_NAME 없이 테스트할 때만 1로 설정 (운영 금지)
ALLOW_PLAINTEXT_PHONE=0

# ── 알림 배치 (notify.py / Cloud Run Job) ──
NOTIFY_ENABLED=0
NOTIFY_DRY_RUN=1
NOTIFY_MAX_PER_RUN=500

# ── Vertex AI Search (RAG) — 비자코드별 검색 앱 ID ──
SEARCH_LOCATION=global
SEARCH_APP_D2=
SEARCH_APP_D4=
SEARCH_APP_D10=
